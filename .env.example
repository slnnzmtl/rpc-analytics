# Trusted project identity (never accepted from ingestion payloads)
PROJECT_ID=rekordbox-playlist-converter
PROJECT_NAME=Rekordbox Playlist Converter

# SQLite path inside the container (volume-mounted)
SQLITE_PATH=/data/analytics.db

# Bearer token for GET /v1/report (curl / federation; never ship to desktop clients)
REPORT_TOKEN=change-me-to-a-long-random-secret

# Supabase Auth for the operator dashboard (reuse existing project; anon/publishable only)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Comma-separated allowlist (case-insensitive)
DASHBOARD_ALLOWED_EMAILS=slonanezametil@gmail.com

# Rate limit (in-memory token bucket per hashed client IP)
RATE_LIMIT_CAPACITY=30
RATE_LIMIT_REFILL_PER_SECOND=0.5

# Daily rotating salt seed for IP hashing (not persisted as IP or hash)
RATE_LIMIT_SALT_SEED=change-me-rate-limit-salt

# Bind (Compose maps 127.0.0.1:8091)
HOST=0.0.0.0
PORT=8091
